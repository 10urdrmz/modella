---
import {
	getEmDashCollection,
	getEmDashEntry,
	getEntriesByTerm,
	getSiteSettings,
	getTaxonomyTerms,
} from "emdash";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import HoneycombIcon from "../../components/HoneycombIcon.astro";
import {
	findCategoryInTree,
	indexCategoryPages,
} from "../../utils/categories";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const slug = Astro.params.slug;
if (!slug) return Astro.rewrite("/404");

const terms = await getTaxonomyTerms("category", { includeCounts: false });
const match = findCategoryInTree(terms, slug);
if (!match) return Astro.rewrite("/404");

const { term, parent, hub } = match;
const isHub = !parent;
const children = term.children ?? [];

const { entry: pageEntry } = await getEmDashEntry("category_pages", slug);
const { entries: allCategoryPages } = await getEmDashCollection("category_pages", {
	limit: 200,
});
const pageBySlug = indexCategoryPages(allCategoryPages);
const pageData = pageEntry?.data ?? pageBySlug.get(slug);

const title = pageData?.title ?? term.label;
const lede =
	pageData?.lede ??
	term.description ??
	(parent
		? `${term.label} — Raydolap Modella kişiye özel üretim.`
		: "");
const heroImage = pageData?.hero_image_path ?? null;

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

let products: Awaited<ReturnType<typeof getEmDashCollection>>["entries"] = [];
try {
	products = await getEntriesByTerm("products", "category", slug, {
		limit: isHub ? 24 : 48,
	});
	if (products.length === 0 && isHub) {
		const { entries } = await getEmDashCollection("products", {
			orderBy: { published_at: "desc" },
			limit: 12,
		});
		products = entries;
	}
} catch {
	const { entries } = await getEmDashCollection("products", {
		orderBy: { published_at: "desc" },
		limit: 12,
	});
	products = entries;
}

const sidebarItems = isHub ? children : (hub.children ?? []);
const sidebarParent = isHub ? term : hub;
const showSubgrid = isHub && children.length > 0;

const childTiles = children.map((child) => {
	const meta = pageBySlug.get(child.slug);
	return {
		slug: child.slug,
		label: meta?.title ?? child.label,
		image: meta?.tile_image_path ?? meta?.hero_image_path ?? null,
	};
});
---

<Base
	title={`${title} — ${siteTitle}`}
	description={lede}
	activeNav={hub.slug === "sale" ? "Sale" : hub.label === "New!" ? "New!" : hub.label}
	content={
		pageEntry
			? { collection: "category_pages", id: pageEntry.data.id, slug }
			: undefined
	}
>
	<nav class="crumb" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span aria-hidden="true">›</span>
		{
			parent ? (
				<>
					<a href={`/category/${hub.slug}`}>{hub.label}</a>
					<span aria-hidden="true">›</span>
					<span>{term.label}</span>
				</>
			) : (
				<span>{term.label}</span>
			)
		}
	</nav>

	<section
		class="cat-hero"
		style={heroImage ? `background-image:url('${heroImage}')` : undefined}
	>
		<div class="cat-hero__veil" aria-hidden="true"></div>
		<div class="cat-hero__copy">
			<p class="cat-hero__mark"><HoneycombIcon /></p>
			<h1 {...pageEntry?.edit.title}>{title}</h1>
			<p {...pageEntry?.edit.lede}>{lede}</p>
		</div>
	</section>

	<div class="cat-layout">
		<aside class="cat-side" aria-label="Category filters">
			<button class="cat-filter" type="button" disabled>
				<svg viewBox="0 0 24 24" aria-hidden="true"
					><path
						d="M4 6h16M7 12h10M10 18h4"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						stroke-linecap="round"></path></svg
				>
				Filter
			</button>
			<nav class="cat-tree">
				<a
					class:list={["cat-tree__parent", { "is-active": isHub }]}
					href={`/category/${sidebarParent.slug}`}
				>
					{sidebarParent.label}
				</a>
				{
					sidebarItems.map((item) => (
						<a
							class:list={["cat-tree__child", { "is-active": term.slug === item.slug }]}
							href={`/category/${item.slug}`}
						>
							{item.label}
						</a>
					))
				}
			</nav>
		</aside>

		<div class="cat-main">
			<div class="cat-main__head">
				<HoneycombIcon />
				<h2>{title}</h2>
			</div>

			{
				showSubgrid ? (
					<div class="subcat-grid">
						{childTiles.map((item) => (
							<a class="subcat-tile" href={`/category/${item.slug}`}>
								<div class="subcat-tile__media">
									{item.image ? (
										<img src={item.image} alt={item.label} loading="lazy" />
									) : (
										<div class="hive-card__placeholder" />
									)}
								</div>
								<span class="subcat-tile__label">{item.label}</span>
							</a>
						))}
					</div>
				) : (
					<div class="hive-grid">
						{products.length === 0 ? (
							<p class="empty-state">No products in this category yet.</p>
						) : (
							products.map((product) => (
								<ProductCard
									href={`/products/${product.id}`}
									title={product.data.title}
									slugOrId={product.id}
									designer={product.data.designer}
									brand={product.data.terms?.brand?.[0]?.label}
									priceLabel={product.data.price_label}
									shippingNote={product.data.shipping_note}
									image={product.data.featured_image}
								/>
							))
						)}
					</div>
				)
			}
		</div>
	</div>
</Base>
