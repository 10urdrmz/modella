---
import { decodeSlug, getEmDashEntry, getSeoMeta, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import ContactBlock from "../components/ContactBlock.astro";
import { phoneToTel, resolveSiteContact } from "../utils/site-contact";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");
if (slug === "home") return Astro.redirect("/");
if (slug === "contact") return Astro.redirect("/contact");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(page, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
});

const showContact = slug === "about" || slug === "trade";
const contact = showContact ? await resolveSiteContact() : null;
const pagePhone = page.data.phone || contact?.phone || null;
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	phone={pagePhone}
	fullBleed={Boolean(page.data.hero_image)}
	content={{ collection: "pages", id: page.data.id, slug }}
>
	<article>
		{
			page.data.hero_image && (
				<section class="page-hero-media" aria-label="Hero">
					<div class="page-hero-media__frame" {...page.edit.hero_image}>
						<Image image={page.data.hero_image} priority />
					</div>
				</section>
			)
		}
		<div class="page-hero">
			{
				page.data.hero_headline ? (
					<>
						<p class="section__eyebrow" {...page.edit.title}>
							{page.data.title}
						</p>
						<h1 {...page.edit.hero_headline}>{page.data.hero_headline}</h1>
					</>
				) : (
					<h1 {...page.edit.title}>{page.data.title}</h1>
				)
			}
			{
				page.data.hero_subcopy && (
					<p class="section__lede" {...page.edit.hero_subcopy}>
						{page.data.hero_subcopy}
					</p>
				)
			}
			{
				(page.data.cta_url || pagePhone) && (
					<div class="hero__actions" style="margin-top:1rem">
						{page.data.cta_url && (
							<a class="btn btn--solid" href={page.data.cta_url} {...page.edit.cta_label}>
								{page.data.cta_label || "Continue"}
							</a>
						)}
						{pagePhone && (
							<a class="btn btn--ghost" href={`tel:${phoneToTel(String(pagePhone))}`}>
								Call {pagePhone}
							</a>
						)}
					</div>
				)
			}
		</div>
		<section class="section prose" style="padding-top:0">
			<PortableText value={page.data.content} />
		</section>
		{
			contact && (
				<section class="section" style="padding-top:0;padding-bottom:var(--space-5)">
					<ContactBlock contact={contact} variant="full" />
				</section>
			)
		}
	</article>
</Base>
