---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import HoneycombIcon from "../../components/HoneycombIcon.astro";
import { resolveStarterSiteIdentity } from "../../utils/site-identity";

const { entries: products, cacheHint } = await getEmDashCollection("products", {
	orderBy: { published_at: "desc" },
	limit: 48,
});
const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<Base
	title={`Furniture — ${siteTitle}`}
	description="Modern designer furniture collection"
	activeNav="Furniture"
>
	<nav class="crumb" aria-label="Breadcrumb">
		<a href="/">Home</a>
		<span aria-hidden="true">›</span>
		<span>Furniture</span>
	</nav>

	<section
		class="cat-hero"
		style="background-image:url('/hive-samples/furniture-hero.jpg')"
	>
		<div class="cat-hero__veil" aria-hidden="true"></div>
		<div class="cat-hero__copy">
			<p class="cat-hero__mark"><HoneycombIcon /></p>
			<h1>Furniture</h1>
			<p>
				The foundation of every great space. Explore modern furniture from the
				world's most celebrated designers and manufacturers.
			</p>
		</div>
	</section>

	<div class="cat-layout">
		<div class="cat-main" style="grid-column:1/-1">
			<div class="cat-main__head">
				<HoneycombIcon />
				<h2>Furniture</h2>
			</div>
			{
				products.length === 0 ? (
					<p class="empty-state">No products published yet.</p>
				) : (
					<div class="hive-grid">
						{products.map((product) => (
							<ProductCard
								href={`/products/${product.id}`}
								title={product.data.title}
								slugOrId={product.id}
								designer={product.data.designer}
								brand={product.data.terms?.brand?.[0]?.label}
								priceLabel={product.data.price_label}
								shippingNote={product.data.shipping_note}
								image={product.data.featured_image}
							/>
						))}
					</div>
				)
			}
		</div>
	</div>
</Base>
