---
import {
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import { resolveStarterSiteIdentity } from "../utils/site-identity";
import { phoneToTel, resolveSiteContact } from "../utils/site-contact";
import { resolveSiteFooter } from "../utils/site-footer";
import { buildMegaNav } from "../utils/mega-nav";
import type { CategoryTermLike } from "../utils/categories";
import SiteFooter from "../components/SiteFooter.astro";
import HiveLogo from "../components/HiveLogo.astro";
import HoneycombIcon from "../components/HoneycombIcon.astro";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	content?: { collection: string; id: string; slug?: string | null };
	phone?: string | null;
	fullBleed?: boolean;
	/** Highlights matching primary nav label (e.g. Accessories) */
	activeNav?: string | null;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	content,
	phone,
	fullBleed = false,
	activeNav = null,
} = Astro.props;
const settingsResult = await getSiteSettingsWithCacheHint();
const menuResult = await getMenuWithCacheHint("primary");
const categoriesResult = await getTaxonomyTermsWithCacheHint("category", {
	includeCounts: false,
});
const [siteContact, siteFooter] = await Promise.all([
	resolveSiteContact(),
	resolveSiteFooter(),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	if (menuResult.cacheHint) Astro.cache.set(menuResult.cacheHint);
	if (categoriesResult.cacheHint) Astro.cache.set(categoriesResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveStarterSiteIdentity(
	settingsResult.data,
);
const titleIncludesSiteName =
	title === siteTitle ||
	title.endsWith(` | ${siteTitle}`) ||
	title.endsWith(` — ${siteTitle}`);
const fullTitle = titleIncludesSiteName ? title : `${title} — ${siteTitle}`;
const pageDescription = description ?? siteTagline;
const displayPhone = phone?.trim() || siteContact.phone;
const displayPhoneTel = phone?.trim()
	? phoneToTel(phone.trim())
	: siteContact.phoneTel;

/** Primary nav from EmDash admin; hubs get Hive-style mega panels from taxonomy */
const navItems = buildMegaNav(
	(menuResult.data?.items ?? []).map((item) => ({
		label: item.label,
		url: item.url || "#",
		sale: item.label.toLowerCase() === "sale",
	})),
	(categoriesResult.data ?? []) as CategoryTermLike[],
);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: "website",
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description: pageDescription,
	canonical,
	image,
	content,
	siteName: siteTitle,
});
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{fullTitle}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
			rel="stylesheet"
		/>
		<meta name="theme-color" content="#ffffff" />
		<EmDashHead page={pageCtx} />
	</head>
	<body>
		<EmDashBodyStart page={pageCtx} />

		<div class="site-shell">
			<header class="site-header">
				<div class="utility-bar">
					<div class="utility-bar__inner">
						<a class="utility-promo" href="/products">
							<HoneycombIcon />
							<span>New! Normann Copenhagen</span>
						</a>
						<div class="utility-bar__right">
							<p class="utility-tagline">Modern Design for the Home</p>
							<div class="utility-links">
								<a class="phone-link" href={`tel:${displayPhoneTel}`}
									>{displayPhone}</a
								>
								<a href="/trade">Trade Program</a>
								<a class="utility-help" href="/about">
									<HoneycombIcon />
									<span>Help</span>
								</a>
							</div>
						</div>
					</div>
				</div>

				<div class="main-bar">
					<div class="main-bar__inner">
						<a class="brand-mark" href="/" aria-label={`${siteTitle} home`}>
							{
								siteLogo ? (
									<img
										src={siteLogo.url}
										alt={siteLogo.alt || siteTitle}
										class="brand-mark__img"
									/>
								) : (
									<HiveLogo title={siteTitle} />
								)
							}
						</a>

						<button
							class="nav-toggle"
							type="button"
							aria-expanded="false"
							aria-controls="primary-nav"
							data-nav-toggle
						>
							<span class="nav-toggle__bars" aria-hidden="true"></span>
							<span class="nav-toggle__label">Menu</span>
						</button>

						<nav class="site-nav" id="primary-nav" data-nav aria-label="Primary">
							{
								navItems.map((item) =>
									item.mega?.length ? (
										<div class="nav-item has-mega" data-mega-item>
											<a
												href={item.url}
												class:list={[
													"nav-item__link",
													{ "is-sale": item.sale },
													{ "is-active": activeNav === item.label },
												]}
												data-mega-trigger
												aria-haspopup="true"
												aria-expanded="false"
											>
												{item.label}
											</a>
											<div class="mega-panel" data-mega-panel hidden>
												<div class="mega-panel__inner">
													{item.mega.map((col) => (
														<div class="mega-col">
															<a class="mega-col__title" href={col.url}>
																{col.title}
															</a>
															{col.links.length > 0 && (
																<ul class="mega-col__list">
																	{col.links.map((link) => (
																		<li>
																			<a href={link.url}>{link.label}</a>
																		</li>
																	))}
																</ul>
															)}
														</div>
													))}
												</div>
											</div>
										</div>
									) : (
										<a
											href={item.url}
											class:list={[
												"nav-item__link",
												{ "is-sale": item.sale },
												{ "is-active": activeNav === item.label },
											]}
										>
											{item.label}
										</a>
									),
								)
							}
						</nav>

						<div class="header-actions" aria-label="Account actions">
							<a class="header-action header-action--search" href="/products" aria-label="Search">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><circle
										cx="11"
										cy="11"
										r="6.5"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"></circle><path
										d="m16 16 4.2 4.2"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
								<span>Search</span>
							</a>
							<a class="header-action" href="/trade" aria-label="Wishlist">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path
										d="M12 20s-7-4.4-7-9.2A3.8 3.8 0 0 1 12 7.5a3.8 3.8 0 0 1 7 3.3C19 15.6 12 20 12 20Z"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linejoin="round"></path></svg
								>
							</a>
							<a class="header-action" href="/_emdash/admin" aria-label="Account">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><circle
										cx="12"
										cy="8"
										r="3.2"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"></circle><path
										d="M5.5 19.2a6.5 6.5 0 0 1 13 0"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"></path></svg
								>
							</a>
							<a class="header-action" href="/products" aria-label="Cart">
								<svg viewBox="0 0 24 24" aria-hidden="true"
									><path
										d="M4 6h2.2l1.3 10.2a1.5 1.5 0 0 0 1.5 1.3h8.2a1.5 1.5 0 0 0 1.5-1.3L20 8H7"
										fill="none"
										stroke="currentColor"
										stroke-width="1.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path><circle
										cx="10"
										cy="20"
										r="1.2"
										fill="currentColor"></circle><circle
										cx="16.5"
										cy="20"
										r="1.2"
										fill="currentColor"></circle></svg
								>
							</a>
						</div>
					</div>
				</div>
			</header>

			<main class="site-main" class:list={[{ "is-full-bleed": fullBleed }]}>
				<slot />
			</main>

			<SiteFooter footer={siteFooter} contact={siteContact} />
		</div>

		<EmDashBodyEnd page={pageCtx} />
		<script>
			const toggle = document.querySelector("[data-nav-toggle]");
			const nav = document.querySelector("[data-nav]");
			const megaItems = document.querySelectorAll("[data-mega-item]");
			const desktopMq = window.matchMedia("(min-width: 900px)");
			/** @type {ReturnType<typeof setTimeout> | null} */
			let closeTimer = null;

			const isDesktop = () => desktopMq.matches;

			const clearCloseTimer = () => {
				if (closeTimer) {
					clearTimeout(closeTimer);
					closeTimer = null;
				}
			};

			/** @param {Element | null | undefined} except */
			const closeAllMega = (except) => {
				megaItems.forEach((item) => {
					if (except && item === except) return;
					item.classList.remove("is-open");
					const trigger = item.querySelector("[data-mega-trigger]");
					const panel = item.querySelector("[data-mega-panel]");
					trigger?.setAttribute("aria-expanded", "false");
					if (panel instanceof HTMLElement) panel.hidden = true;
				});
			};

			/** @param {Element} item */
			const openMega = (item) => {
				clearCloseTimer();
				closeAllMega(item);
				item.classList.add("is-open");
				const trigger = item.querySelector("[data-mega-trigger]");
				const panel = item.querySelector("[data-mega-panel]");
				trigger?.setAttribute("aria-expanded", "true");
				if (panel instanceof HTMLElement) panel.hidden = false;
			};

			const scheduleClose = () => {
				clearCloseTimer();
				closeTimer = setTimeout(() => closeAllMega(), 160);
			};

			toggle?.addEventListener("click", () => {
				const open = nav?.classList.toggle("is-open");
				toggle.setAttribute("aria-expanded", open ? "true" : "false");
				document.body.classList.toggle("nav-open", !!open);
				if (!open) closeAllMega();
			});

			megaItems.forEach((item) => {
				const trigger = item.querySelector("[data-mega-trigger]");
				const panel = item.querySelector("[data-mega-panel]");

				trigger?.addEventListener("click", (event) => {
					if (isDesktop()) return;
					event.preventDefault();
					const willOpen = !item.classList.contains("is-open");
					if (willOpen) openMega(item);
					else closeAllMega();
				});

				item.addEventListener("mouseenter", () => {
					if (isDesktop()) openMega(item);
				});
				item.addEventListener("mouseleave", () => {
					if (isDesktop()) scheduleClose();
				});
				item.addEventListener("focusin", () => {
					if (isDesktop()) openMega(item);
				});
				item.addEventListener("focusout", (event) => {
					if (!isDesktop()) return;
					const next = event.relatedTarget;
					if (next instanceof Node && item.contains(next)) return;
					scheduleClose();
				});

				/* Keep panel interactive: don't let parent leave-close win mid-click */
				panel?.addEventListener("mouseenter", () => {
					if (isDesktop()) openMega(item);
				});
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape") {
					clearCloseTimer();
					closeAllMega();
				}
			});
		</script>
	</body>
</html>
