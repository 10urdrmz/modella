---
/**
 * Hive-style full-screen image lightbox.
 * Triggers: [data-lightbox] with data-lightbox-src, optional
 * data-lightbox-group, data-lightbox-title, data-lightbox-index.
 */
import BrandMark from "./BrandMark.astro";

interface Props {
	siteTitle?: string;
}

const { siteTitle = "hive" } = Astro.props;
---

<dialog class="lightbox" data-lightbox-root aria-label="Image gallery">
	<div class="lightbox__top">
		<p class="lightbox__title" data-lightbox-title></p>
		<div class="lightbox__top-right">
			<a class="lightbox__brand" href="/" aria-label={`${siteTitle} home`}>
				<BrandMark title={siteTitle} variant="full" />
			</a>
			<button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
				<span aria-hidden="true">×</span>
			</button>
		</div>
	</div>

	<div class="lightbox__stage">
		<button
			type="button"
			class="lightbox__nav lightbox__nav--prev"
			data-lightbox-prev
			aria-label="Previous image"
		>
			<span aria-hidden="true">‹</span>
		</button>
		<img class="lightbox__image" data-lightbox-image alt="" />
		<button
			type="button"
			class="lightbox__nav lightbox__nav--next"
			data-lightbox-next
			aria-label="Next image"
		>
			<span aria-hidden="true">›</span>
		</button>
	</div>

	<div class="lightbox__bottom">
		<div class="lightbox__thumbs" data-lightbox-thumbs role="list"></div>
		<div class="lightbox__meta">
			<span data-lightbox-count>1 / 1</span>
			<button
				type="button"
				class="lightbox__meta-next"
				data-lightbox-next
				aria-label="Next image"
			>
				▶
			</button>
		</div>
	</div>
</dialog>

<script>
	const root = document.querySelector("[data-lightbox-root]");
	if (root instanceof HTMLDialogElement) {
		const titleEl = root.querySelector("[data-lightbox-title]");
		const imageEl = root.querySelector("[data-lightbox-image]");
		const thumbsEl = root.querySelector("[data-lightbox-thumbs]");
		const countEl = root.querySelector("[data-lightbox-count]");
		const closeBtn = root.querySelector("[data-lightbox-close]");
		const prevBtns = root.querySelectorAll("[data-lightbox-prev]");
		const nextBtns = root.querySelectorAll("[data-lightbox-next]");

		/** @type {{ src: string, title: string }[]} */
		let items = [];
		let index = 0;

		const render = () => {
			if (!items.length || !(imageEl instanceof HTMLImageElement)) return;
			const item = items[index];
			imageEl.src = item.src;
			imageEl.alt = item.title || "";
			if (titleEl) titleEl.textContent = item.title || "";
			if (countEl) countEl.textContent = `${index + 1} / ${items.length}`;
			thumbsEl?.querySelectorAll("[data-lightbox-thumb]").forEach((btn, i) => {
				btn.classList.toggle("is-active", i === index);
				btn.setAttribute("aria-current", i === index ? "true" : "false");
			});
		};

		const buildThumbs = () => {
			if (!(thumbsEl instanceof HTMLElement)) return;
			thumbsEl.innerHTML = "";
			items.forEach((item, i) => {
				const btn = document.createElement("button");
				btn.type = "button";
				btn.className = "lightbox__thumb";
				btn.setAttribute("data-lightbox-thumb", "");
				btn.setAttribute("aria-label", `Image ${i + 1}`);
				btn.innerHTML = `<img src="${item.src}" alt="" loading="lazy" />`;
				btn.addEventListener("click", () => {
					index = i;
					render();
				});
				thumbsEl.appendChild(btn);
			});
		};

		const openAt = (group, startIndex, fallbackTitle) => {
			const triggers = [
				...document.querySelectorAll(`[data-lightbox][data-lightbox-group="${group}"]`),
			];
			items = triggers
				.map((el) => ({
					src: el.getAttribute("data-lightbox-src") || "",
					title:
						el.getAttribute("data-lightbox-title") ||
						fallbackTitle ||
						"",
				}))
				.filter((item) => item.src);
			if (!items.length) return;
			index = Math.max(0, Math.min(startIndex, items.length - 1));
			buildThumbs();
			render();
			if (!root.open) root.showModal();
			document.body.classList.add("lightbox-open");
		};

		const close = () => {
			if (root.open) root.close();
			document.body.classList.remove("lightbox-open");
		};

		const step = (delta) => {
			if (!items.length) return;
			index = (index + delta + items.length) % items.length;
			render();
		};

		document.addEventListener("click", (event) => {
			const target = event.target;
			if (!(target instanceof Element)) return;
			const trigger = target.closest("[data-lightbox]");
			if (!trigger) return;
			event.preventDefault();
			const group = trigger.getAttribute("data-lightbox-group") || "default";
			const start = Number(trigger.getAttribute("data-lightbox-index") || "0");
			const title = trigger.getAttribute("data-lightbox-title") || "";
			openAt(group, Number.isFinite(start) ? start : 0, title);
		});

		closeBtn?.addEventListener("click", close);
		prevBtns.forEach((btn) => btn.addEventListener("click", () => step(-1)));
		nextBtns.forEach((btn) => btn.addEventListener("click", () => step(1)));

		root.addEventListener("click", (event) => {
			if (event.target === root) close();
		});

		document.addEventListener("keydown", (event) => {
			if (!root.open) return;
			if (event.key === "Escape") close();
			if (event.key === "ArrowRight") step(1);
			if (event.key === "ArrowLeft") step(-1);
		});

		root.addEventListener("close", () => {
			document.body.classList.remove("lightbox-open");
		});
	}
</script>

<style is:global>
	body.lightbox-open {
		overflow: hidden;
	}

	.lightbox {
		width: 100vw;
		max-width: 100vw;
		height: 100vh;
		max-height: 100vh;
		margin: 0;
		padding: 0;
		border: 0;
		background: #fff;
		color: var(--ink, #4a4a4a);
		display: none;
		flex-direction: column;
	}

	.lightbox[open] {
		display: flex;
	}

	.lightbox::backdrop {
		background: rgba(255, 255, 255, 0.92);
	}

	.lightbox__top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem clamp(1rem, 3vw, 2rem);
		flex: 0 0 auto;
	}

	.lightbox__title {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 400;
		color: var(--ink-soft, #6b6b6b);
		letter-spacing: -0.01em;
	}

	.lightbox__top-right {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.lightbox__brand {
		display: flex;
		align-items: center;
		line-height: 0;
		text-decoration: none;
	}

	.lightbox__brand .brand-e--full {
		width: 56px;
		height: 43px;
	}

	.lightbox__close {
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--ink-soft, #6b6b6b);
		font-size: 1.8rem;
		line-height: 1;
		cursor: pointer;
		padding: 0.15rem 0.35rem;
	}

	.lightbox__close:hover {
		color: var(--ink-strong, #2f2f2f);
	}

	.lightbox__stage {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		display: grid;
		place-items: center;
		padding: 0.5rem 3.5rem 0.75rem;
	}

	.lightbox__image {
		max-width: min(920px, 100%);
		max-height: calc(100vh - 11.5rem);
		width: auto;
		height: auto;
		object-fit: contain;
		background: #f6f6f6;
	}

	.lightbox__nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		width: 2.6rem;
		height: 2.6rem;
		border-radius: 999px;
		border: 1px solid var(--line, rgba(47, 47, 47, 0.15));
		background: #fff;
		color: var(--ink-strong, #2f2f2f);
		font-size: 1.55rem;
		line-height: 1;
		cursor: pointer;
		display: grid;
		place-items: center;
		padding: 0 0 0.15rem;
		box-shadow: 0 4px 16px rgba(16, 20, 24, 0.08);
	}

	.lightbox__nav--prev {
		left: 0.75rem;
	}

	.lightbox__nav--next {
		right: 0.75rem;
	}

	.lightbox__nav:hover {
		border-color: var(--ink-strong, #2f2f2f);
	}

	.lightbox__bottom {
		flex: 0 0 auto;
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: end;
		gap: 1rem;
		padding: 0.5rem clamp(1rem, 3vw, 2rem) 1rem;
	}

	.lightbox__thumbs {
		display: flex;
		gap: 0.45rem;
		overflow-x: auto;
		padding-bottom: 0.15rem;
		justify-content: center;
	}

	.lightbox__thumb {
		flex: 0 0 3.4rem;
		width: 3.4rem;
		height: 3.4rem;
		padding: 0;
		border: 0;
		background: #eee;
		cursor: pointer;
		position: relative;
	}

	.lightbox__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	.lightbox__thumb.is-active::after {
		content: "";
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.28rem;
		height: 2px;
		background: var(--hive-yellow, #e6b347);
	}

	.lightbox__meta {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: 0.85rem;
		color: var(--ink-soft, #6b6b6b);
		white-space: nowrap;
		padding-bottom: 0.35rem;
	}

	.lightbox__meta-next {
		appearance: none;
		border: 0;
		background: transparent;
		color: var(--ink-soft, #6b6b6b);
		cursor: pointer;
		font-size: 0.7rem;
		padding: 0.2rem;
	}

	@media (max-width: 720px) {
		.lightbox__stage {
			padding: 0.25rem 2.6rem;
		}

		.lightbox__nav {
			width: 2.2rem;
			height: 2.2rem;
			font-size: 1.35rem;
		}

		.lightbox__brand {
			display: none;
		}

		.lightbox__thumb {
			flex-basis: 2.8rem;
			width: 2.8rem;
			height: 2.8rem;
		}
	}
</style>
