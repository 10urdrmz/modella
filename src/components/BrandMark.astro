---
/**
 * Primary brand mark — exact uploaded asset (not redrawn).
 * File: /public/brand/logo-e.png
 */
interface Props {
	title?: string;
	variant?: "full" | "compact";
	class?: string;
}

const {
	title = "hive",
	variant = "full",
	class: className = "",
} = Astro.props;

const src = "/brand/logo-e.png";
---

<img
	src={src}
	alt={variant === "full" ? title : ""}
	width="94"
	height="72"
	decoding="async"
	class:list={[
		"brand-e",
		variant === "compact" ? "brand-e--compact" : "brand-e--full",
		className,
	]}
	aria-hidden={variant === "compact" ? "true" : undefined}
/>
