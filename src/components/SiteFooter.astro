---
import type { SiteContact } from "../utils/site-contact";
import type { SiteFooterContent } from "../utils/site-footer";

interface Props {
	footer: SiteFooterContent;
	contact: SiteContact;
}

const { footer, contact } = Astro.props;
const edit = footer.edit;
const socials = [
	{ key: "instagram", label: "Instagram", href: footer.socialInstagram, icon: "instagram" },
	{ key: "facebook", label: "Facebook", href: footer.socialFacebook, icon: "facebook" },
	{ key: "vimeo", label: "Vimeo", href: footer.socialVimeo, icon: "vimeo" },
].filter((s) => s.href);
---

<footer class="site-footer">
	<div class="site-footer__shell">
		<div class="site-footer__grid">
			<section class="site-footer__col site-footer__col--newsletter" aria-label="Newsletter">
				<h2 class="site-footer__heading" {...edit?.newsletter_heading}>
					{footer.newsletterHeading}
				</h2>
				<form class="site-footer__newsletter" action="#" method="post" data-newsletter>
					<label class="site-footer__field">
						<span class="site-footer__field-label" {...edit?.newsletter_placeholder}
							>{footer.newsletterPlaceholder}</span
						>
						<span class="site-footer__field-row">
							<input
								type="email"
								name="email"
								autocomplete="email"
								required
								aria-label={footer.newsletterPlaceholder}
							/>
							<button type="submit" class="site-footer__submit" aria-label="Subscribe">
								<span aria-hidden="true">›</span>
							</button>
						</span>
					</label>
					<p class="site-footer__disclaimer">
						<span {...edit?.newsletter_disclaimer}>{footer.newsletterDisclaimer}</span>{" "}
						<a href={footer.privacyUrl} {...edit?.privacy_label}>{footer.privacyLabel}</a>
					</p>
				</form>
			</section>

			<nav class="site-footer__col" aria-label={footer.supportHeading}>
				<h2 class="site-footer__heading" {...edit?.support_heading}>{footer.supportHeading}</h2>
				<ul class="site-footer__list">
					{
						footer.supportLinks.map((item) => (
							<li>
								<a href={item.url}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>

			<section class="site-footer__col" aria-label={footer.contactHeading}>
				<h2 class="site-footer__heading" {...edit?.contact_heading}>{footer.contactHeading}</h2>
				<ul class="site-footer__list site-footer__list--contact">
					{
						contact.email && (
							<li>
								<a href={`mailto:${contact.email}`} {...contact.edit?.email}>
									{contact.email}
								</a>
							</li>
						)
					}
					<li>
						<a
							class="phone-link"
							href={`tel:${contact.phoneTel}`}
							{...contact.edit?.phone}
						>
							{contact.phone}
						</a>
					</li>
					<li {...contact.edit?.location_name}>{contact.locationName}</li>
					<li class="site-footer__address" {...contact.edit?.address}>{contact.address}</li>
					{
						contact.hours.slice(0, 3).map((line) => (
							<li class="site-footer__hours-line">{line}</li>
						))
					}
					{
						contact.hours.length > 3 && (
							<li>
								<a href="/contact">All hours</a>
							</li>
						)
					}
					<li>
						<a href={footer.helpCenterUrl} {...edit?.help_center_label}
							>{footer.helpCenterLabel}</a
						>
					</li>
				</ul>
			</section>

			<nav class="site-footer__col" aria-label={footer.accountHeading}>
				<h2 class="site-footer__heading" {...edit?.account_heading}>{footer.accountHeading}</h2>
				<ul class="site-footer__list">
					{
						footer.accountLinks.map((item) => (
							<li>
								<a href={item.url}>{item.label}</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		<div class="site-footer__bottom">
			<a class="site-footer__lockup" href="/" aria-label={`${footer.bottomBrandPrimary} home`}>
				<span class="site-footer__lockup-primary" {...edit?.bottom_brand_primary}
					>{footer.bottomBrandPrimary}</span
				>
				{
					footer.bottomBrandSecondary && (
						<>
							<span class="site-footer__lockup-slash" aria-hidden="true">
								/
							</span>
							<span class="site-footer__lockup-secondary" {...edit?.bottom_brand_secondary}>
								{footer.bottomBrandSecondary}
							</span>
						</>
					)
				}
			</a>
			{
				socials.length > 0 && (
					<ul class="site-footer__social" aria-label="Social media">
						{socials.map((s) => (
							<li>
								<a href={s.href!} aria-label={s.label} target="_blank" rel="noopener noreferrer">
									{s.icon === "instagram" && (
										<svg viewBox="0 0 24 24" aria-hidden="true"
											><rect
												x="3.5"
												y="3.5"
												width="17"
												height="17"
												rx="4"
												fill="none"
												stroke="currentColor"
												stroke-width="1.4"></rect><circle
												cx="12"
												cy="12"
												r="4"
												fill="none"
												stroke="currentColor"
												stroke-width="1.4"></circle><circle
												cx="17.2"
												cy="6.8"
												r="1"
												fill="currentColor"></circle></svg
										>
									)}
									{s.icon === "facebook" && (
										<svg viewBox="0 0 24 24" aria-hidden="true"
											><path
												d="M14.2 8.5V6.9c0-.7.5-1.1 1.2-1.1h1.4V3.5h-2.3c-2.3 0-3.7 1.5-3.7 3.8v1.2H9v2.6h1.8V20.5h3.4V11.1h2.3l.5-2.6h-2.8Z"
												fill="currentColor"></path></svg
										>
									)}
									{s.icon === "vimeo" && (
										<svg viewBox="0 0 24 24" aria-hidden="true"
											><path
												d="M20.4 8.2c-.1 2.3-1.7 5.5-4.8 9.5-3.2 4.2-5.9 6.3-8.1 6.3-1.4 0-2.5-1.3-3.5-3.8L2.6 15c.7 0 1.5.1 2.3.1 1.1 0 2.1-.2 2.9-.7.9-.5 1.7-1.5 2.4-2.9.4-.8.8-2.1 1.2-3.8.3-1.4.5-2.4.5-3 .1-.9-.2-1.3-.9-1.3-.4 0-.9.2-1.5.6l.9-3.6C12 1.7 13.7 1 15.5 1c1.3 0 2.2.5 2.7 1.5.4.7.6 1.8.5 3.3.1.7.2 1.5.2 2.4.1.9.2 1.6.2 2.1.1.5.2.9.3 1.1.1.2.2.3.4.3.3 0 .7-.4 1.2-1.3l.9 1.1c-.5.9-1 1.5-1.5 1.7Z"
												fill="currentColor"></path></svg
										>
									)}
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</div>
</footer>

<script>
	document.querySelectorAll("[data-newsletter]").forEach((form) => {
		form.addEventListener("submit", (event) => {
			event.preventDefault();
		});
	});
</script>
