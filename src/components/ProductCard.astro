---
import { Image } from "emdash/ui";
import { sampleImageForProduct } from "../data/catalog";

interface Props {
	href: string;
	title: string;
	slugOrId: string;
	designer?: string | null;
	brand?: string | null;
	priceLabel?: string | null;
	shippingNote?: string | null;
	image?: { id?: string; src?: string; alt?: string } | null;
}

const {
	href,
	title,
	slugOrId,
	designer,
	brand,
	priceLabel,
	shippingNote,
	image,
} = Astro.props;
const byline = [brand, designer].filter(Boolean).join(" ");
const sampleSrc = sampleImageForProduct(slugOrId);
---

<a class="hive-card" href={href}>
	<div class="hive-card__media">
		{
			sampleSrc ? (
				<img src={sampleSrc} alt={title} loading="lazy" />
			) : image ? (
				<Image image={image} />
			) : (
				<div class="hive-card__placeholder" aria-hidden="true" />
			)
		}
	</div>
	<div class="hive-card__body">
		<h2 class="hive-card__title">{title}</h2>
		{
			priceLabel && (
				<p class="hive-card__price">
					<span>{priceLabel}</span>
					{shippingNote && <span class="hive-card__ship">{shippingNote}</span>}
				</p>
			)
		}
		{byline && <p class="hive-card__byline">{byline}</p>}
	</div>
</a>
