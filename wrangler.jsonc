{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "modella",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "modella"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "modella-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"triggers": {
		"crons": ["* * * * *"]
	},
	"observability": {
		"enabled": true
	}
}
