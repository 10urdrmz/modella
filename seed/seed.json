				"slug": "home",
				"status": "published",
				"data": {
					"title": "Home",
					"hero_headline": "Kişiye özel raydolap ve mobilya",
					"hero_subcopy": "1999’dan bu yana Masko’da ölçüye özel üretim — Raydolap Modella.",
					"cta_label": "Raydolapları incele",
					"cta_url": "/category/raydolap",
					"phone": "(0212) 675 20 57",
					"hero_image": {
						"$media": {
							"url": "https://hivemodern.com/public_resources/home-page-199bdebb58.jpg",
							"alt": "Modern designer furniture at hive",
							"filename": "hive-home-hero.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "h0",
							"children": [
								{
									"_type": "span",
									"text": "A trusted partner to architects and interior designers who refuse to compromise on quality.",
									"_key": "h1"
								}
							]
						}
					]
				}
			},
			{
				"id": "about",
				"slug": "about",
				"status": "published",
				"data": {
					"title": "Hakkımızda",
					"hero_headline": "Hakkımızda",
					"hero_subcopy": "1999’dan bu yana kişiye özel mobilya — Masko Mobilya Kenti’nde Raydolap Modella.",
					"phone": "(0212) 675 20 57",
					"hero_image": {
						"$media": {
							"url": "https://static.wixstatic.com/media/09b89b_41d19a825b194fefaef80472ef5196fe~mv2.jpg/v1/fill/w_1600,h_1067,al_c,q_90/09b89b_41d19a825b194fefaef80472ef5196fe~mv2.jpg",
							"alt": "Modella Raydolap mağaza",
							"filename": "modella-about-hero.jpg"
						}
					},
					"content": [
						{
							"_type": "block",
							"style": "normal",
							"_key": "a0",
							"children": [
								{
									"_type": "span",
									"text": "Raydolap Modella olarak markalaşan firmamız ilk 1999 yılında kurulmuş olup, sektörde kişiye özel mobilya üretimi olarak hizmet vermeye başlamıştır.",
									"_key": "a1"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "a2",
							"children": [
								{
									"_type": "span",
									"text": "Yıllar içinde daima yenilikçilik anlayışı ile sürekli kendine değer katmayı başarmıştır.",
									"_key": "a3"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "a4",
							"children": [
								{
									"_type": "span",
									"text": "2008’li yıllarda 3 boyutlu tasarım, proje ve uygulamayı gerçekleştirmiştir.",
									"_key": "a5"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "a6",
							"children": [
								{
									"_type": "span",
									"text": "Müşteri memnuniyeti ve ilklere imza atmayı hedefleyen firmamız dünde olduğu gibi bugün ve yarınlar için daha da kaliteli hizmet sağlamayı hedeflemektedir.",
									"_key": "a7"
								}
							]
						},
						{
							"_type": "block",
							"style": "normal",
							"_key": "a8",
							"children": [
								{
									"_type": "span",
									"text": "Üretim bandı tamamen kendi bünyemizde olup, uzman ekip ve kadromuzla yılların vermiş olduğu profesyonellik ve tecrübemizle öncelikle siz değerli müşterilerimiz için kaliteli yaşam alanları oluşturmaya ve yeniliklere imza atmaya devam edeceğiz.",
									"_key": "a9"
								}
							]
						}
					],
					"phone_secondary": "+90 533 631 86 57",
					"story_image_path": "/modella-about/photo2.jpg",
					"faq": [
						{
							"question": "Teslim süreniz nedir?",
							"answer": "Teslim süresi sezon yoğunluğuna göre 25 ila 40 gün aralığında değişmektedir."
						},
						{
							"question": "Hangi malzemeler kullanılıyor?",
							"answer": "Ahşap kısımlarda Mdflam, membran ve lake boya seçeneklerimiz mevcuttur."
						},
						{
							"question": "Tasarım aşaması nasıl ilerliyor?",
							"answer": "Mağazamızda uzman ekibimiz ile 3d max formatında evinizin öncelikle yerleşim planı hazırlanır, bütçe planlamasının ardından anlaşıldığı takdirde detaylı proje ve sunumlara başlanır."
						},
						{
							"question": "Yurt dışı gönderimleriniz var mıdır?",
							"answer": "Avrupa ülkelerine özel kurulum hariç, anlaşmalı kapıya teslim firmalar ile gönderim sağlıyoruz."
						},
						{
							"question": "Hangi ürünleri üretebiliyorsunuz?",
							"answer": "Modern tarzda yatak odaları, giyinme odaları, genç odaları, çalışma odaları, vestiyer, tv üniteleri ve benzeri ürünlerin üretimini yapmaktayız."
						},
						{
							"question": "Ödeme işlemleri nasıl oluyor?",
							"answer": "Nakit ve kredi kartı taksit seçeneklerimiz mevcuttur."
						},
						{
							"question": "Kurulum ve montaj ekstra ücretli midir?",
							"answer": "İstanbul içi tüm ilçelerimize ücretsiz kurulum sağlıyoruz. Şehir dışı projelerde ise projenin durumuna göre fiyatlama yapılmaktadır."
						},
						{
							"question": "Ürünleri görebileceğimiz mağazanız nerede?",
							"answer": "Ürünlerimizi Masko Mobilya Kenti Modella mağazamızda veya sosyal mecralardan görebilirsiniz."
						},
						{
							"question": "Hangi kartlara taksit yapıyorsunuz?",
							"answer": "Genel olarak tüm kredi kartlarına taksit seçeneklerimiz mevcuttur."
						},
						{
							"question": "Neden Modella Raydolap’ı tercih etmeliyim?",
							"answer": "Yılların vermiş olduğu tecrübe ile standardın dışında ihtiyacınıza, zevkinize, evinize özel kaliteli ürünler üretiyoruz. Satış sonrası her daim destek sağlıyoruz."
						},
						{
							"question": "Ürünün evimde nasıl duracağını önceden görebilir miyim?",
							"answer": "Proje taslak onayı sonrasında evinizin, odanızın detaylı 3 boyutlu hali üzerine mobilya yerleşimi yapılıp farklı açılardan resim formatındaki görünümlerini sizlere sunuyoruz."
						},
						{
							"question": "Garanti süreniz nedir? Garanti koşulları neyi kapsar?",
							"answer": "Mobilyaların yasal olarak garanti süresi 2 yıldır. Ancak Modella Raydolap olarak ürünlerimizin her daim arkasındayız."
						},
						{
							"question": "Ürünler hazır mı? Siparişe özel mi hazırlanıyor?",
							"answer": "Ürünlerimizin tamamı sizlerin siparişlerine özel olarak hazırlanmaktadır."
						},
						{
							"question": "Renk ve tasarım değişimini ne zamana kadar yapabilirim?",
							"answer": "Proje onayı sonrasında 2-3 gün için değişim imkanı sunuyoruz."
						},
						{
							"question": "Mobilya yaptırmak istiyorum. Ancak fikir almaya ihtiyacım var. Nasıl yardımcı oluyorsunuz?",
							"answer": "Sizleri mağazamıza bir kahveye davet edip ihtiyacınıza yönelik, alanlarınıza en uygun şekilde proje taslağı sunuyoruz."
						},
						{
							"question": "Montaj aşaması nasıl oluyor?",
							"answer": "Ürünler kendi tesisimizde montaja hazır hale getirildikten sonra ambalajlı bir şekilde sipariş teslim tarihinizde yine uzman ekibimiz ile birlikte kurulum ve teslimat gerçekleştirilir."
						},
						{
							"question": "Renk seçeneklerimiz nelerdir?",
							"answer": "Zevkinize uyacak yüzlerce ahşap ve kumaş seçeneklerimiz mevcuttur."
						},
						{
							"question": "Ürünleri tekli alabilir miyiz? Yurt içi her yere gönderim yapıyor musunuz?",
							"answer": "Öncelikli olarak İstanbul iline, projenin durumuna göre ise çevre illere hizmet sağlıyoruz."
						}
					],
